generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  MEMBER
  REVIEWER
  ADMIN
}

enum PasswordResetRequestStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

enum VideoStatus {
  PROCESSING
  PENDING_REVIEW
  APPROVED
  REJECTED
  REVOKED
  FAILED
}

enum VideoAppealStatus {
  PENDING
  APPROVED
  REJECTED
}

enum VideoSecondaryReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum LedgerType {
  VIDEO_REWARD
  TRANSFER_IN
  TRANSFER_OUT
  ADMIN_ADJUSTMENT
  REDEMPTION
  REDEMPTION_REFUND
  REVERSAL
  WEEKLY_CHALLENGE_REWARD
  WEEKLY_RACE_REWARD
  WEEKLY_CHALLENGE_REVERSAL
  WEEKLY_RACE_REVERSAL
  MEMBER_CLEARANCE_FORFEIT
}

enum TransferStatus {
  COMPLETED
  REJECTED
}

enum RedemptionStatus {
  PENDING
  APPROVED
  FULFILLED
  REJECTED
  REFUNDED
  CLEARANCE_CANCELLED
}

enum GiftKind {
  PHYSICAL
  CASH
  MEMBERSHIP
}

enum RankingPeriodType {
  WEEK
  MONTH
}

enum RankingPeriodStatus {
  OPEN
  SETTLED
}

enum RankingAwardStatus {
  PENDING
  CLAIMED
  FULFILLED
  EXPIRED
}

enum NotificationType {
  ANNOUNCEMENT
  VIDEO_RESULT
  APPEAL_RESULT
  POINTS
  TRANSFER
  REDEMPTION
  RANKING_RESULT
  RANKING_AWARD
  WEEKLY_CHALLENGE
  MEMBER_CLEARANCE
  ACHIEVEMENT
}

enum MemberEligibilityStatus {
  ACTIVE
  COOLDOWN
  REJOIN_PENDING
  REJOIN_REJECTED
  EXEMPT
}

enum RejoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WeeklyChallengePeriodStatus {
  GENERATING
  READY
  ACTIVE
  CLOSED
  FAILED
  CANCELLED
}

enum WeeklyChallengeType {
  VIDEO_COUNT
  LIKE_SUM
  COMBINED
}

enum WeeklyChallengeAssignmentStatus {
  ACTIVE
  COMPLETED
  CLAIMED
  REVERSED
  EXPIRED
}

enum WeeklyChallengeAttemptStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  WITHDRAWN
}

enum AnnouncementAudience {
  ALL
  SELECTED
}

model User {
  id               String               @id @default(cuid())
  kuaishouId       String               @unique
  nickname         String
  avatarUrl        String?
  passwordHash     String
  role             Role                 @default(MEMBER)
  active           Boolean              @default(true)
  guildStatus      String?
  boundPhoneEnc    String?
  invited          Boolean              @default(false)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  account          PointAccount?
  recipientProfile RecipientProfile?
  videos           VideoSubmission[]
  videoAppeals     VideoAppeal[]      @relation("AppealRequester")
  reviewedAppeals  VideoAppeal[]      @relation("AppealReviewer")
  secondaryVideoReviews VideoSecondaryReview[] @relation("SecondaryVideoReviewer")
  rankingEntries   RankingEntry[]
  rankingAwards    RankingAward[]
  outgoing         Transfer[]           @relation("sender")
  incoming         Transfer[]           @relation("receiver")
  redemptions      RedemptionOrder[]
  auditLogs        AuditLog[]           @relation("actor")
  notifications    Notification[]
  announcements    Announcement[]       @relation("AnnouncementCreator")
  announcementRecipients AnnouncementRecipient[]
  guildHistory     GuildStatusHistory[]
  sessions         Session[]
  operationSettings SystemSetting[]     @relation("OperationSettingUpdater")
  weeklyChallengeAssignments WeeklyChallengeAssignment[]
  weeklyRaceWins             WeeklyRaceWinner[]
  passwordResetRequests      PasswordResetRequest[] @relation("PasswordResetTarget")
  reviewedPasswordResetRequests PasswordResetRequest[] @relation("PasswordResetReviewer")
  eligibility                MemberEligibility?
  clearancePolicyVersions    MembershipClearancePolicyVersion[] @relation("ClearancePolicyCreator")
  rejoinRequests             RejoinRequest[]
  reviewedRejoinRequests     RejoinRequest[] @relation("RejoinReviewer")
  growthProfile              MemberGrowthProfile?
  achievements               MemberAchievement[]
  monthlyGoals               MemberMonthlyGoal[]
  monthlyReviews             MemberMonthlyReview[]
}

model MemberClearanceProgram {
  id             String   @id @default("default")
  firstEnabledAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MembershipClearancePolicyVersion {
  id             String              @id @default(cuid())
  version        Int                 @unique
  inactivityDays Int
  warningDays    Int[]
  cooldownDays   Int
  createdById    String?
  createdAt      DateTime            @default(now())
  createdBy      User?               @relation("ClearancePolicyCreator", fields: [createdById], references: [id], onDelete: SetNull)
  eligibilities  MemberEligibility[]

  @@index([createdAt])
}

model MemberEligibility {
  id              String                  @id @default(cuid())
  userId          String                  @unique
  policyVersionId String
  status          MemberEligibilityStatus @default(ACTIVE)
  cycleStartedAt  DateTime
  lastOutputAt    DateTime?
  warning14SentAt DateTime?
  warning3SentAt  DateTime?
  clearedAt       DateTime?
  cooldownEndsAt  DateTime?
  rejoinRetryAt   DateTime?
  onboardingSeenAt DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  user            User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyVersion   MembershipClearancePolicyVersion @relation(fields: [policyVersionId], references: [id])
  rejoinRequests  RejoinRequest[]

  @@index([status, cooldownEndsAt])
  @@index([status, cycleStartedAt])
}

model RejoinRequest {
  id            String              @id @default(cuid())
  eligibilityId String
  userId        String
  status        RejoinRequestStatus @default(PENDING)
  requestedAt   DateTime            @default(now())
  reviewedAt    DateTime?
  reviewedById  String?
  reviewReason  String?
  eligibility   MemberEligibility   @relation(fields: [eligibilityId], references: [id], onDelete: Cascade)
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy    User?               @relation("RejoinReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, requestedAt])
  @@index([userId, requestedAt])
}

model PasswordResetRequest {
  id                   String                     @id @default(cuid())
  userId               String
  proposedPasswordHash String
  status               PasswordResetRequestStatus @default(PENDING)
  expiresAt            DateTime
  reviewedById         String?
  reviewedAt           DateTime?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  user                 User                       @relation("PasswordResetTarget", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy           User?                      @relation("PasswordResetReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([userId, status])
}

model Session {
  id        String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model GuildStatusHistory {
  id        String   @id @default(cuid())
  userId    String
  status    String
  reason    String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model PointAccount {
  id        String        @id @default(cuid())
  userId    String        @unique
  balance   Int           @default(0)
  version   Int           @default(0)
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledger    PointLedger[]
}

model PointLedger {
  id             String       @id @default(cuid())
  accountId      String
  type           LedgerType
  amount         Int
  balanceAfter   Int
  referenceId    String?
  note           String?
  idempotencyKey String?      @unique
  createdAt      DateTime     @default(now())
  account        PointAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@index([referenceId])
}

model VideoPointRule {
  id                  String   @id @default("default")
  minimumLikes        Int      @default(200)
  fixedTierMaxLikes   Int      @default(1000)
  fixedTierPoints     Int      @default(50)
  likesDivisor        Int      @default(2)
  maximumPoints       Int      @default(5000)
  submissionWindowDays Int     @default(7)
  updatedById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model VideoSubmission {
  id                String      @id @default(cuid())
  userId            String
  sourceUrl         String
  requestUrl        String
  sourceKind        String
  status            VideoStatus @default(PROCESSING)
  shortCode         String?
  photoId           String?
  likes             Int?
  views             Int?
  commentCount      Int?
  caption           String?
  coverUrl          String?
  metadataFetchedAt DateTime?
  publishedAt       DateTime?
  fetchedOwner      String?
  matchedOwner      Boolean?
  points            Int         @default(0)
  submittedNickname String
  submittedAt       DateTime    @default(now())
  processedAt       DateTime?
  reviewedAt        DateTime?
  reviewReason      String?
  rawPayload        Json?
  idempotencyKey    String      @unique
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  appeals           VideoAppeal[]
  secondaryReview   VideoSecondaryReview?

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
  @@index([photoId, status])
}

model VideoSecondaryReview {
  id           String                     @id @default(cuid())
  videoId      String                     @unique
  reviewerId   String?
  status       VideoSecondaryReviewStatus @default(PENDING)
  reviewReason String?
  assignedAt   DateTime?
  reviewedAt   DateTime?
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
  video        VideoSubmission            @relation(fields: [videoId], references: [id], onDelete: Cascade)
  reviewer     User?                      @relation("SecondaryVideoReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reviewerId, status, createdAt])
}

model VideoAppeal {
  id              String            @id @default(cuid())
  videoId         String
  userId          String
  reason          String
  status          VideoAppealStatus @default(PENDING)
  reviewReason    String?
  reviewedPoints  Int?
  idempotencyKey  String            @unique
  createdAt       DateTime          @default(now())
  reviewedAt      DateTime?
  reviewedById    String?
  video           VideoSubmission   @relation(fields: [videoId], references: [id], onDelete: Cascade)
  user            User              @relation("AppealRequester", fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy      User?             @relation("AppealReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([videoId, createdAt])
  @@index([userId, createdAt])
}

model Transfer {
  id             String         @id @default(cuid())
  senderId       String
  receiverId     String
  amount         Int
  status         TransferStatus @default(COMPLETED)
  note           String?
  idempotencyKey String         @unique
  createdAt      DateTime       @default(now())
  sender         User           @relation("sender", fields: [senderId], references: [id])
  receiver       User           @relation("receiver", fields: [receiverId], references: [id])

  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
}

model Gift {
  id            String            @id @default(cuid())
  name          String
  kind          GiftKind          @default(PHYSICAL)
  pointsCost    Int
  stock         Int               @default(0)
  imageUrl      String?
  description   String?
  category      String            @default("实用好物")
  tags          String[]          @default([])
  fulfillmentFields Json?
  active        Boolean           @default(true)
  pinned        Boolean           @default(false)
  displayOrder  Int               @default(0)
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  orders        RedemptionOrder[]
  rankingAwards RankingAward[]

  @@index([deletedAt, active, pinned, displayOrder])
  @@index([deletedAt, active, category])
}

model MemberGrowthProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  experience     Int      @default(0)
  level          Int      @default(1)
  scoreVersion   String   @default("v1")
  calculatedAt   DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MemberAchievement {
  id          String   @id @default(cuid())
  userId      String
  code        String
  earnedAt    DateTime @default(now())
  metadata    Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId, earnedAt])
}

model MemberMonthlyGoal {
  id                 String   @id @default(cuid())
  userId             String
  monthStart         DateTime
  baselineVideos     Int
  baselineEngagement Int
  targetVideos       Int
  targetEngagement   Int
  completedAt        DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthStart])
  @@index([userId, monthStart])
}

model MemberMonthlyReview {
  id               String   @id @default(cuid())
  userId           String
  monthStart       DateTime
  approvedVideos   Int
  engagement       Int
  goalCompleted    Boolean
  baselineVideos   Int      @default(0)
  baselineEngagement Int    @default(0)
  previousVideos   Int      @default(0)
  previousEngagement Int    @default(0)
  highlightVideoId String?
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, monthStart])
  @@index([userId, monthStart])
}

model RedemptionOrder {
  id                  String           @id @default(cuid())
  userId              String
  giftId              String
  quantity            Int              @default(1)
  unitCost            Int
  totalCost           Int
  status              RedemptionStatus @default(PENDING)
  shippingInfo        String?
  recipientName       String?
  recipientPhoneEnc   String?
  recipientAddressEnc String?
  cashQrCodeUrl       String?
  fulfillmentDataEnc  String?
  note                String?
  idempotencyKey      String           @unique
  createdAt           DateTime         @default(now())
  reviewedAt          DateTime?
  fulfilledAt         DateTime?
  trackingNumber      String?
  user                User             @relation(fields: [userId], references: [id])
  gift                Gift             @relation(fields: [giftId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model RecipientProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  recipientName String?
  phoneEnc      String?
  addressEnc    String?
  cashQrCodeUrl String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RankingPeriod {
  id          String              @id @default(cuid())
  type        RankingPeriodType
  periodStart DateTime
  periodEnd   DateTime
  status      RankingPeriodStatus @default(OPEN)
  settledAt   DateTime?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  entries     RankingEntry[]
  awards      RankingAward[]

  @@unique([type, periodStart])
  @@index([type, status, periodStart])
}

model RankingEntry {
  id         String        @id @default(cuid())
  periodId   String
  userId     String
  rank       Int
  value      Int
  videoCount Int           @default(0)
  likes      Int           @default(0)
  createdAt  DateTime      @default(now())
  period     RankingPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([periodId, userId])
  @@unique([periodId, rank])
  @@index([periodId, rank])
}

model RankingAward {
  id                  String             @id @default(cuid())
  periodId            String
  userId              String
  rank                Int
  value               Int
  rewardTitle        String?
  rewardDescription  String?
  giftId              String?
  status              RankingAwardStatus @default(PENDING)
  recipientName       String?
  recipientPhoneEnc   String?
  recipientAddressEnc String?
  cashQrCodeUrl       String?
  claimedAt           DateTime?
  fulfilledAt         DateTime?
  createdAt           DateTime           @default(now())
  period              RankingPeriod      @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  gift                Gift?              @relation(fields: [giftId], references: [id], onDelete: SetNull)

  @@unique([periodId, userId])
  @@unique([periodId, rank])
  @@index([userId, status])
}

model Announcement {
  id          String               @id @default(cuid())
  title       String
  content     String
  status      AnnouncementStatus   @default(DRAFT)
  audience    AnnouncementAudience
  createdById String
  publishedAt DateTime?
  withdrawnAt DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt
  createdBy   User                 @relation("AnnouncementCreator", fields: [createdById], references: [id])
  recipients  AnnouncementRecipient[]
  notifications Notification[]

  @@index([status, createdAt])
  @@index([createdById, createdAt])
}

model AnnouncementRecipient {
  announcementId String
  userId         String
  createdAt      DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([announcementId, userId])
  @@index([userId, createdAt])
}

model Notification {
  id             String           @id @default(cuid())
  userId         String
  type           NotificationType
  title          String
  body           String
  entityType     String?
  entityId       String?
  metadata       Json?
  readAt         DateTime?
  dedupeKey      String           @unique
  announcementId String?
  createdAt      DateTime         @default(now())
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  announcement   Announcement?    @relation(fields: [announcementId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([userId, createdAt])
  @@index([announcementId])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId     String?
  action      String
  entity      String
  entityId    String?
  beforeValue Json?
  afterValue  Json?
  reason      String?
  ip          String?
  requestId   String?
  createdAt   DateTime @default(now())
  actor       User?    @relation("actor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}

model SystemSetting {
  key         String   @id
  enabled     Boolean  @default(true)
  description String?
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   User?    @relation("OperationSettingUpdater", fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([updatedAt])
}

model WeeklyChallengePeriod {
  id                   String                             @id @default(cuid())
  periodStart          DateTime                           @unique
  periodEnd            DateTime
  claimEndsAt          DateTime
  status               WeeklyChallengePeriodStatus        @default(GENERATING)
  personalRewardBudget Int                                @default(10000)
  raceReward           Int                                @default(2000)
  rewardPolicyVersion  String                             @default("single-v1")
  model                String
  promptVersion        String                             @default("v1")
  audienceSnapshot     Json
  audienceCount        Int
  generationRunId      String?
  generationStartedAt  DateTime?
  generatedAt          DateTime?
  activatedAt          DateTime?
  closedAt             DateTime?
  failureReason        String?
  createdAt            DateTime                           @default(now())
  updatedAt            DateTime                           @updatedAt
  assignments          WeeklyChallengeAssignment[]
  attempts             WeeklyChallengeGenerationAttempt[]
  raceWinner           WeeklyRaceWinner?

  @@index([status, periodStart])
}

model WeeklyChallengeAssignment {
  id                 String                          @id @default(cuid())
  periodId           String
  userId             String
  type               WeeklyChallengeType
  status             WeeklyChallengeAssignmentStatus @default(ACTIVE)
  baselineVideoCount Int                             @default(0)
  baselineLikes      Int                             @default(0)
  weeklyVideoCounts  Json
  weeklyLikeSums     Json
  targetVideoCount   Int?
  targetLikes        Int?
  rewardPoints       Int
  rewardTiers        Json?
  claimedRewardPoints Int                            @default(0)
  claimedTier        Int                            @default(-1)
  difficultyScore    Int
  title              String
  description        String
  aiReason           String
  completedAt        DateTime?
  claimedAt          DateTime?
  claimIdempotencyKey String?                         @unique
  reversedAt         DateTime?
  createdAt          DateTime                        @default(now())
  updatedAt          DateTime                        @updatedAt
  period             WeeklyChallengePeriod           @relation(fields: [periodId], references: [id], onDelete: Cascade)
  user               User                            @relation(fields: [userId], references: [id], onDelete: Cascade)
  raceWin            WeeklyRaceWinner?

  @@unique([periodId, userId])
  @@index([userId, status, createdAt])
  @@index([periodId, status, completedAt])
}

model WeeklyChallengeGenerationAttempt {
  id              String                       @id @default(cuid())
  periodId        String
  batchNumber     Int
  attemptNumber   Int
  status          WeeklyChallengeAttemptStatus @default(RUNNING)
  model           String
  promptVersion   String
  promptHash      String
  requestId       String
  memberCount     Int
  latencyMs       Int?
  inputTokens     Int?
  outputTokens    Int?
  error           String?
  validatedOutput Json?
  createdAt       DateTime                     @default(now())
  updatedAt       DateTime                     @updatedAt
  period          WeeklyChallengePeriod        @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@unique([periodId, batchNumber, attemptNumber])
  @@index([periodId, status, createdAt])
}

model WeeklyRaceWinner {
  id           String                    @id @default(cuid())
  periodId     String                    @unique
  assignmentId String                    @unique
  userId       String
  rewardPoints Int
  wonAt        DateTime
  reversedAt   DateTime?
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  period       WeeklyChallengePeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  assignment   WeeklyChallengeAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  user         User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, wonAt])
}

model LegacyImport {
  id          String   @id @default(cuid())
  sourceTable String
  sourceId    String
  rawValue    Json
  importedAt  DateTime @default(now())

  @@unique([sourceTable, sourceId])
}
